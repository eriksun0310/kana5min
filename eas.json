{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development",
      "env": {
        "RELEASE_CHANNEL": "development"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "env": {
        "RELEASE_CHANNEL": "production"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      },
      "channel": "production",
      "env": {
        "RELEASE_CHANNEL": "production"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "production",
      "channel": "development-device",
      "env": {
        "RELEASE_CHANNEL": "development-device"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
