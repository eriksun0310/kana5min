{
  "name": "kana5min",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:ios": "eas build --platform ios --profile production --local",
    "build:android:aab": "eas build --platform android --profile production --local",
    "build:android:apk": "eas build --platform android --profile production-apk --local",
    "prebuild": "expo prebuild",
    "gen:puns": "node scripts/gen-puns.mjs",
    "check:puns": "node scripts/gen-puns.mjs --check"
  },
  "dependencies": {
    "@expo-google-fonts/klee-one": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-purchases": "^10.16.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eas-cli": "^26.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "msedge-tts": "^2.1.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  }
}
